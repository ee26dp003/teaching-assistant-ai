# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to GitHub.

# Your Hugging Face access token (https://huggingface.co/settings/tokens)
HF_TOKEN=your_huggingface_token_here

# The Hugging Face model to use for the teaching assistant.
# Must be a model that supports chat-completion via the HF Inference API.
# You can swap this for any other supported chat model without touching the code.
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Optional: which inference provider to route the request through.
# "auto" lets Hugging Face pick an available provider for the chosen model.
HF_PROVIDER=auto
